# Chrome headless
alias chl="/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --disable-gpu --remote-debugging-port=9222"
alias ccl="/Applications/CocCoc.app/Contents/MacOS/CocCoc --headless --disable-gpu --remote-debugging-port=9222"
alias ccr="/Applications/CocCoc.app/Contents/MacOS/CocCoc --remote-debugging-port=9233"

# Convert lf2crlf
alias ems2data="vim -c \"set ff=dos\" -c \"set bomb\" -c \":wq\""

# PHP
alias php82="/opt/homebrew/opt/php@8.2/bin/php"
alias php74="/opt/homebrew/opt/php@7.4/bin/php"

# Composer
alias c74="php74 /opt/local/bin/composer"
alias c82="php82 /opt/local/bin/composer"

# Artisan
alias a74="php74 artisan"
alias a82="php82 artisan"

# Docker
alias dc="docker compose"

# Vim
alias vim="nvim"

# File
if command -v eza &> /dev/null; then
    alias ls="eza --icons --group-directories-first"
    alias l="eza -la --icons --group-directories-first --hyperlink"
    alias lt="eza --tree --level=2 --icons"
fi

# Cat
if command -v bat &> /dev/null; then
    alias cat="bat --style=plain"
fi

# Lazy
alias lg="lazygit"
alias ld="lazydocker"

# Kubenets
alias k=kubectl
alias h=helm

# F :)) 
alias c="clear"

alias md="merge_develop"


## Docker alias
# https://github.com/ohmyzsh/ohmyzsh/blob/master/plugins/docker/docker.plugin.zsh
alias dbl='docker build'
alias dcin='docker container inspect'
alias dcls='docker container ls'
alias dclsa='docker container ls -a'
alias dib='docker image build'
alias dii='docker image inspect'
alias dils='docker image ls'
alias dipu='docker image push'
alias dipru='docker image prune -a'
alias dirm='docker image rm'
alias dit='docker image tag'
alias dlo='docker container logs'
alias dnc='docker network create'
alias dncn='docker network connect'
alias dndcn='docker network disconnect'
alias dni='docker network inspect'
alias dnls='docker network ls'
alias dnrm='docker network rm'
alias dpo='docker container port'
alias dps='docker ps'
alias dpsa='docker ps -a'
alias dpu='docker pull'
alias dr='docker container run'
alias drit='docker container run -it'
alias drm='docker container rm'
alias 'drm!'='docker container rm -f'
alias dst='docker container start'
alias drs='docker container restart'
alias dsta='docker stop $(docker ps -q)'
alias dstp='docker container stop'
alias dsts='docker stats'
alias dtop='docker top'
alias dvi='docker volume inspect'
alias dvls='docker volume ls'
alias dvprune='docker volume prune'
alias dxc='docker container exec'
alias dxcit='docker container exec -it'

## Docker compose alias
# https://github.com/ohmyzsh/ohmyzsh/blob/master/plugins/docker-compose/docker-compose.plugin.zsh
[[ -x "${commands[docker-compose]:A}" ]] && dccmd='docker-compose' || dccmd='docker compose'

alias dco="$dccmd"
alias dca="$dccmd attach"
alias dcb="$dccmd build"
alias dce="$dccmd exec"
alias dcps="$dccmd ps"
alias dcrestart="$dccmd restart"
alias dcrm="$dccmd rm"
alias dcr="$dccmd run"
alias dcstop="$dccmd stop"
alias dcup="$dccmd up"
alias dcupb="$dccmd up --build"
alias dcupd="$dccmd up -d"
alias dcupdb="$dccmd up -d --build"
alias dcdn="$dccmd down"
alias dcl="$dccmd logs"
alias dclf="$dccmd logs -f"
alias dclF="$dccmd logs -f --tail 0"
alias dcpull="$dccmd pull"
alias dcstart="$dccmd start"
alias dck="$dccmd kill"

unset dccmd

## AWS alias
alias aws-g="aws --profile gajoen-oversea"

## Claude
alias cl="claude"

## Tmux cheat
alias ta='s=$(basename "$PWD"); tmux has-session -t "$s" 2>/dev/null && tmux attach -t "$s" || tmux new -s "$s"'

## Laravel Sail
alias sail='sh $([ -f sail ] && echo sail || echo vendor/bin/sail)'

