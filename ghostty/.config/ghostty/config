################################
# FONT
################################

font-family = "JetBrains Mono"
font-size = 14
font-feature = calt
font-synthetic-style = bold,italic,bold-italic

################################
# RENDERING
################################

alpha-blending = native
grapheme-width-method = unicode

################################
# THEME & COLORS
################################

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#bac2de
background = 1e1e2e
foreground = cdd6f4
cursor-color = f5e0dc
cursor-text = 11111b
selection-background = 353749
selection-foreground = cdd6f4
split-divider-color = 313244
minimum-contrast = 1.1
bold-color = bright

################################
# TRANSPARENCY (mac)
################################

background-opacity = 0.90
background-blur = 20

################################
# CURSOR
################################

cursor-style = block
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true

################################
# SCROLLBACK
################################

scrollback-limit = 200000000
scroll-to-bottom = keystroke,no-output

################################
# SHELL INTEGRATION
################################

shell-integration-features = no-cursor,title,path

################################
# WINDOW
################################

window-decoration = auto
window-save-state = always
window-new-tab-position = current
maximize = false
window-padding-x = 12
window-padding-y = 12
macos-titlebar-style = tabs
macos-window-shadow = true

################################
# LINKS
################################

link-url = true
link-previews = true
selection-clear-on-typing = true
selection-clear-on-copy = false

################################
# MAC KEY
################################

macos-option-as-alt = true

################################
# KEYBINDS
################################

keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+n=new_window
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = opt+left=goto_split:left
keybind = opt+right=goto_split:right
keybind = opt+up=goto_split:top
keybind = opt+down=goto_split:bottom
keybind = global:cmd+grave_accent=toggle_quick_terminal

confirm-close-surface = false
